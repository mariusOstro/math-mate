# Required on the server only. Set the same values in Vercel's environment settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional independent secret for the anonymous browser binding cookie.
# If omitted, a purpose-specific signature is derived from SUPABASE_SECRET_KEY.
BROWSER_ID_SECRET=
# Required to enable the scheduled session cleanup endpoint on Vercel.
CRON_SECRET=
# Per-browser AI limits, plus a global daily spending guard. Requests, not tokens.
CHAT_REQUESTS_PER_MINUTE=8
CHAT_REQUESTS_PER_DAY=100
CHAT_GLOBAL_REQUESTS_PER_DAY=1000
NEXT_TELEMETRY_DISABLED=1
