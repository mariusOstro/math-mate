{
  "name": "math-mate",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src di lib scripts tests next.config.ts",
    "format": "prettier --write app src di lib scripts tests README.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx scripts/db/check.ts",
    "db:smoke": "tsx scripts/db/smoke.ts",
    "db:import": "tsx scripts/db/import-problems.ts",
    "db:preview": "supabase db push --dry-run",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "katex": "^0.16.24",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "openai": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
